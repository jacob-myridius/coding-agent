{
  "name": "myridius-implementation-agent",
  "version": "1.0.0",
  "description": "AI-powered code implementation agent for Azure DevOps work items",
  "main": "dist/worker/worker.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:build": "docker build -t myridius-implementation-agent .",
    "docker:run": "docker run -p 8080:80 myridius-implementation-agent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@azure/event-hubs": "^5.12.0",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/openai": "^1.0.0-beta.12",
    "@azure/search-documents": "^12.0.0",
    "axios": "^1.6.0",
    "simple-git": "^3.24.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  },
  "keywords": [
    "azure",
    "devops",
    "ai",
    "implementation",
    "automation"
  ],
  "author": "Your Organization",
  "license": "MIT"
}

